rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserRole() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    // Users collection - users can read/write their own data
    match /users/{userId} {
      function isSelf() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Users may only pick customer or seller for themselves; admin is granted by an admin
      function hasSelfAssignableRole() {
        return request.resource.data.get('role', 'customer') in ['customer', 'seller'];
      }

      function keepsRole() {
        return request.resource.data.get('role', null) == resource.data.get('role', null);
      }

      // Allow users to manage their own profile without escalating their role
      allow create: if (isSelf() && hasSelfAssignableRole()) || isAdmin();
      allow update: if (isSelf() && (keepsRole() || hasSelfAssignableRole())) || isAdmin();
      allow delete: if isSelf() || isAdmin();

      // Allow authenticated users to read any user profile (for shop details, chat search)
      allow get: if request.auth != null;

      // Allow querying seller profiles for authenticated users (chat search, product pages)
      allow list: if request.auth != null;
    }
    
    // Products collection
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      // Only sellers can write their own products
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid == resource.data.userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Logs collection - only admins can read
    match /logs/{logId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null;
    }
    
    // Orders collection
    match /orders/{orderId} {
      // Buyers can read their own orders
      allow read: if request.auth != null && request.auth.uid == resource.data.buyerId;
      // Sellers can read orders where they are the seller or in sellerIds array
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid in resource.data.sellerIds
      );
      // Admins can read and write all orders
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      // Buyers can create orders (checkout) and update their own orders (e.g., upload payment slip)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.buyerId;
      // Sellers can update orders where they're listed as a seller
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.sellerId ||
        request.auth.uid in resource.data.sellerIds
      );
    }
    
    // Chat Rooms collection
    match /chatRooms/{chatRoomId} {
      // Users can read chat rooms where they are a participant
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.sellerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      // Users can create chat rooms
      allow create: if request.auth != null;
      // Participants and admins can update chat rooms
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.sellerId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Chat Messages collection
    match /chatMessages/{messageId} {
      function isRoomParticipant(chatId) {
        let room = get(/databases/$(database)/documents/chatRooms/$(chatId)).data;
        return request.auth.uid == room.customerId || request.auth.uid == room.sellerId;
      }

      // Only participants of the message's chat room (and admins) can read it
      allow read: if request.auth != null && (isRoomParticipant(resource.data.chatId) || isAdmin());
      // Participants send messages as themselves
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.senderId
        && (isRoomParticipant(request.resource.data.chatId) || isAdmin());
      // Participants mark messages as read; admins can soft-delete
      allow update: if request.auth != null && (isRoomParticipant(resource.data.chatId) || isAdmin());
    }

    // Chat History collection - one document per user listing their chat room IDs
    match /chatHistory/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Starting a chat also records the room in the other participant's history
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatRooms', 'totalChats', 'updatedAt']);
    }
    
    // Coupons collection
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'seller'];
    }
    
    // Pending users collection - only admins can read/write
    match /pending_users/{pendingUserId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
